# Copy this file to .env.local and fill in real values.

# Base URL of the BrickDAO NestJS API.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Get a free WalletConnect/RainbowKit project id from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="YOUR_PROJECT_ID"

# "true" to add Sepolia to the list of selectable chains in RainbowKit.
NEXT_PUBLIC_ENABLE_TESTNETS="false"

# Deployed AssetFactory address (see ../contracts/README.md). Individual
# properties can also override this with their own contractAddress.
NEXT_PUBLIC_ASSET_FACTORY_ADDRESS=""
