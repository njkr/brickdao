# Copy this file to .env and fill in real values before running the app.

# Postgres connection string for Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brickdao"

# HTTP port the Nest app listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (no wildcard in production).
CORS_ORIGINS="http://localhost:3000"

# Secrets used to sign access/refresh JWTs. Generate with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Wallet addresses (comma-separated, lowercase) that get the ADMIN role the
# first time they sign in. This replaces the old frontend-only hardcoded
# admin address list — the check now happens server-side, at the source of
# truth for the user's role.
ADMIN_WALLET_ADDRESSES=""

# Deployed AssetFactory address (see contracts/README.md). Used only by the
# seed script to attach seeded properties to a real contract; leave unset
# until you've deployed one.
ASSET_FACTORY_ADDRESS=""
