# Hardhat 3 resolves these via configVariable(): from the encrypted keystore
# (`npx hardhat keystore set <NAME>`) or from environment variables of the same name.
# Only needed to deploy to a real network; local tests/deploys need nothing.

# JSON-RPC endpoint for Sepolia (e.g. from your RPC provider's dashboard).
SEPOLIA_RPC_URL="https://sepolia.example.com/v2/YOUR_API_KEY"

# Private key of the deployer account (use a throwaway testnet wallet only).
SEPOLIA_PRIVATE_KEY="0xYOUR_TESTNET_PRIVATE_KEY"
